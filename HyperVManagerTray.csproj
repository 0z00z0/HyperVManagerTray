<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HyperVManagerTray</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Suppress the XAML-generated Main so Program.cs can provide its own
         entry point with a top-level try-catch for startup failure visibility. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- WinUI 3 / Windows App SDK, unpackaged (no MSIX). -->
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- Identity / packaging metadata -->
    <AssemblyTitle>Hyper-V Manager Tray</AssemblyTitle>
    <Product>Hyper-V Manager Tray</Product>
    <Description>System-tray app that auto-connects a Hyper-V VM to the right virtual switch and controls VMs from a dashboard.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>2.7.9</Version>
    <Authors>ZeroZero Software</Authors>
    <Company>ZeroZero Software</Company>
    <Copyright>Copyright © 2026 ZeroZero Software</Copyright>
    <RepositoryUrl>https://github.com/0z00z0/HyperVManagerTray</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Assembly-level neutral language, matching 0z0-shared's repo-wide Directory.Build.props. It
         stamps NeutralResourcesLanguageAttribute("en-GB") on the assembly, which describes the
         language the built-in strings are written in; it does not select a formatting culture, so
         InvariantGlobalization below and the CurrentCulture the UI formats with are untouched. -->
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!-- The language the merged app PRI is built for. Separate from NeutralLanguage above, which stamps
         the assembly: this one is MakePRI's default, and without it the shared MQTT module's en-GB .resw
         is compared against en-US and warns PRI257. No library can declare it on the app's behalf. -->
    <DefaultLanguage>en-GB</DefaultLanguage>

    <!-- Must stay OFF: invariant mode makes EVERY Task Scheduler write throw, and pins the UI's
         formatting to the invariant culture. Machine-readable text pins InvariantCulture at each
         call site instead — see Tests\CultureBoundaryTests.cs. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Versions live in Directory.Packages.props at the repository root; these references carry the
       package name alone so the app and the test project cannot drift apart. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- The file sink behind Microsoft.Extensions.Logging, and the log rotation the hand-rolled
         StreamWriter never had (issue #55). Configured in code, not NLog.config — see
         Services\FileLogger.cs — so there is no config file for an unpackaged app to fail to find. -->
    <PackageReference Include="NLog" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Management" />
    <!-- Typed Task Scheduler API behind Services\StartupManager.cs. schtasks /Create cannot set
         DisallowStartIfOnBatteries/StopIfGoingOnBatteries, and their defaults are what stopped the
         logon task ever starting the app on battery (issue #61). -->
    <PackageReference Include="TaskScheduler" />
  </ItemGroup>

  <!-- The shared ZeroZero Software components, taken from the studio's GitHub Packages feed. One
       reference per component, carrying the package name alone; the versions are in
       Directory.Packages.props, and nuget.config names the feed and maps ZeroZero.* to it. A
       version resolves the same assemblies here as on a runner, so what a local build compiles and
       what a release ships are the same code. -->
  <ItemGroup>
    <!-- The studio mark, the About window, the typeface and the palette brushes. Replaces a
         hand-rolled UI/AboutWindow. -->
    <PackageReference Include="ZeroZero.Brand.WinUI" />
    <!-- The MQTT module. One reference delivers all four assemblies: ZeroZero.Config,
         ZeroZero.Mqtt, ZeroZero.Mqtt.Discovery and the settings panel. -->
    <PackageReference Include="ZeroZero.Mqtt.WinUI" />
    <!-- The single-instance lock, the relaunch on an exit nobody asked for and its three-in-ten-
         minutes limit, behind Helpers\AppLifecycle.cs. It brings ZeroZero.Primitives (already here
         through the MQTT module) and Microsoft.Win32.SystemEvents with it. -->
    <PackageReference Include="ZeroZero.Lifecycle" />
    <!-- The self-update flow behind Services\AppUpdate.cs: the release check, and the download that is
         verified against the release's published SHA-256 and against the signer below before it is
         allowed to run — twice, the second time at the moment of launch. The entry point is the Win32
         package; it brings ZeroZero.Update with it, and ZeroZero.Win32 is already here through the
         brand component. -->
    <PackageReference Include="ZeroZero.Update.Win32" />
  </ItemGroup>

  <!-- The publisher certificate, as the pin an installer's signature is checked against. Embedded
       rather than stated as a thumbprint constant: Helpers\ExpectedPublisher.cs reads the subject and
       the SHA-256 thumbprint out of these bytes at runtime, so the app and the release workflow — which
       verifies every produced binary against this same file — cannot drift apart, and there is no
       thumbprint literal anywhere to update when the certificate is replaced.

       Rotating the certificate means adding the new .cer here one release BEFORE it is first used to
       sign, so copies already installed accept it. Every embedded .cer is a pin; the LogicalName is
       explicit so the resource is named identically in the test assembly, which embeds the same file. -->
  <ItemGroup>
    <EmbeddedResource Include="scripts\ZeroZeroSoftware.cer" LogicalName="ZeroZeroSoftware.cer" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.json is NOT a Content item: the app writes its blank slate to %AppData%, and a copy in
         the publish folder would be installed over the file a rolled-back build still reads. The
         repo's config.json is the blank slate Tests\DefaultConfigTests byte-compares against. -->
    <!-- AppIcon.ico: HyperVManagerTray's OWN product icon (0z0-guideline product-icon set, #26) —
         a plated, high-contrast VM-monitor glyph in the app's own muted palette (blue plate, white
         glyph, green connection dot); NOT the studio [Ø] mark, NOT borrowed from any sibling app.
         Embedded in the exe PE resources (ApplicationIcon) and used as the installer SetupIconFile.
         Generated by installer\Generate-AppIcon.ps1 (one script → one consistent family). -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- AppIcon.png: the same plated product icon as AppIcon.ico, emitted at 256px by
         installer\Generate-AppIcon.ps1. Shipped so ms-appx:///Assets/AppIcon.png resolves at runtime
         for the Settings pane-footer identity block (issue #35) — WinUI's <Image> cannot load an .ico.
         Without CopyToOutputDirectory the PNG is stripped from the output and the image renders blank. -->
    <Content Include="Assets\AppIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- app.ico: same plated product icon as AppIcon.ico, kept so build-installer.ps1's presence
         check has a file to find. Also generated by Generate-AppIcon.ps1. -->
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- TrayBlue.ico: the flat blue (Fallback) VM glyph on a transparent background, so the Start
         Menu shortcut matches the runtime tray icon (the icon-*-v5.ico files are generated on first
         launch and don't exist at install time). Same v5 glyph geometry as Helpers\IconGenerator.cs;
         regenerate via installer\Generate-AppIcon.ps1 if the glyph changes. -->
    <Content Include="Assets\TrayBlue.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Two-tone Settings nav icons (product blue #3B7EC4 line + green #359E6A accent), mirroring
         the sibling app's duotone nav set. Shipped as SVG assets so ms-appx:///Assets/nav/*.svg
         resolves for the NavigationView ImageIcons. -->
    <Content Include="Assets\nav\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The unit-test project lives under Tests\ (its own csproj). Keep its sources out of the
       app build; the test project links the specific source files it needs instead. -->
  <ItemGroup>
    <Compile   Remove="Tests\**\*.cs" />
    <Content   Remove="Tests\**\*" />
    <None      Remove="Tests\**\*" />
    <Page      Remove="Tests\**\*" />
  </ItemGroup>

  <!-- Publish properties: ReadyToRun on Release; trimming OFF (WinUI + reflection-y bits are
       fragile to trim). JSON uses a source-generated context so config still works without it. -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Bundle the Windows App SDK with the app so no machine-wide runtime install is needed. It
         belongs here rather than on a publish command line: a command-line property is global and
         MSBuild carries it into every referenced project, where a class library errors on it. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!--
    `dotnet publish` for an unpackaged WinUI 3 app drops the app resource index
    ($(AssemblyName).pri) holding the compiled XAML resources. Without it Microsoft.UI.Xaml.dll
    crashes at startup (stowed exception 0xC000027B). Copy it into the publish output.
  -->
  <!--
    Code-sign the Release exe using scripts\sign.ps1 (same self-signed cert as LenovoTray).
    Run .\scripts\sign.ps1 -Setup once on the dev machine to create + trust the certificate.
    ContinueOnError means a missing cert never breaks the build.
  -->
  <Target Name="SignOutput" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\sign.ps1&quot; -Path &quot;$(TargetDir)$(AssemblyName).exe&quot;"
          ContinueOnError="true" />
  </Target>

  <Target Name="CopyAppPriToPublish" AfterTargets="Publish"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
