<Project>

  <!-- Every NuGet version this repository declares, gathered here so the application and the test
       project reference package names only. Four of these packages are used by both, and a bump
       applied to one project file alone would otherwise leave the tests running against a
       different version than the application ships. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <!-- At or above 0z0-shared's pins. A direct reference BELOW a transitive one is NU1605, an
         error: the shared pins are a floor a consumer must meet, not one a lower local pin
         overrides. -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="NLog" Version="6.2.1" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    <PackageVersion Include="System.Management" Version="10.0.12" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <!-- The shared ZeroZero Software components, from the studio's GitHub Packages feed named in
       nuget.config. One version per component, and a component's entry point carries its own other
       assemblies transitively — ZeroZero.Config, ZeroZero.Mqtt and ZeroZero.Primitives all arrive
       that way and are pinned nowhere here.

       Every component is pre-1.0, where a minor bump may break the API and a patch never does.
       Raising one of these numbers is a deliberate step: read that component's release notes under
       docs/release-notes/<key>/ in the 0z0-shared repository first. -->
  <ItemGroup>
    <!-- 0.10.0 gives the bracket action button a symbol of its own and a column that sets several of
         them to one width, and holds the About window's dismissal while another window of this
         application is on screen. Both brand assemblies release under the same number. -->
    <PackageVersion Include="ZeroZero.Brand.Core" Version="0.10.0" />
    <PackageVersion Include="ZeroZero.Brand.WinUI" Version="0.10.0" />
    <PackageVersion Include="ZeroZero.Lifecycle" Version="0.7.1" />
    <!-- 0.8.0: the logon task's seven power settings, including no execution time limit, and a repair
         that notices a task pointing at an executable under an old install path. 0.8.1 adds a
         watchdog task that restarts an application the scheduler finds gone; it is additive and this
         application registers no such task, so the logon task behaves exactly as on 0.8.0. -->
    <PackageVersion Include="ZeroZero.Startup" Version="0.8.1" />
    <!-- 0.7.2 closes the disposal race on the connection's reconcile gate and the discovery
         publisher's announcement gate: a settings change applied after teardown, or a reconnect
         still in flight at exit, could each end the process. Never go below it. 0.7.3 keeps an
         unreachable broker from filling mqtt.log: one line when the link goes, one when it returns. -->
    <PackageVersion Include="ZeroZero.Mqtt.Discovery" Version="0.7.3" />
    <PackageVersion Include="ZeroZero.Mqtt.WinUI" Version="0.7.3" />
    <!-- 0.9.0 adds TransientWindows, the count of this application's own short-lived windows.
         UI\DashboardWindow.xaml.cs asks it before dismissing itself on lost focus, so the dashboard
         stays put when the update window opens in front of it. 0.9.1 adds WindowFit, the arithmetic
         that fits a window into a work area; additive, and nothing here calls it yet. -->
    <PackageVersion Include="ZeroZero.Win32" Version="0.9.1" />
    <!-- The three update assemblies release under one number and are raised together.
         0.8.0 reports a timeout, an unreachable host, a failure status and an unreadable release as
         four outcomes rather than two, which is the split every message about a failed check is
         written to. It also keeps UpdateScheduler.Dispose idempotent: this app stops the schedule
         before handing over to an installer and disposes again on the way out.
         0.9.0 returns the release alongside the outcome from a check, joins a second caller to a
         check already in flight instead of refusing it, and gives each refusal its own sentence.
         Its release-trust setting is deliberately NOT taken: this application keeps requiring the
         pinned thumbprint, so a certificate minted with the same publisher name is still refused.
         0.10.0 paces the download's progress for a surface and ends a completed download with its
         true byte count. 0.11.0 draws every step of an update as one window in the studio's style,
         which is what ZeroZero.Update.WinUI carries; ZeroZero.Update.Win32 keeps the flow, the
         interface and the wording and arrives with it. -->
    <PackageVersion Include="ZeroZero.Update" Version="0.11.0" />
    <PackageVersion Include="ZeroZero.Update.Win32" Version="0.11.0" />
    <PackageVersion Include="ZeroZero.Update.WinUI" Version="0.11.0" />
  </ItemGroup>

  <!-- Test project only. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
