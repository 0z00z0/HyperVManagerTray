<Project>

  <!-- Every NuGet version this repository declares, gathered here so the application and the test
       project reference package names only. Four of these packages are used by both, and a bump
       applied to one project file alone would otherwise leave the tests running against a
       different version than the application ships. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <!-- At or above 0z0-shared's pins. A direct reference BELOW a transitive one is NU1605, an
         error: the shared pins are a floor a consumer must meet, not one a lower local pin
         overrides. -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageVersion Include="NLog" Version="6.1.4" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.8" />
    <PackageVersion Include="System.Management" Version="10.0.8" />
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <!-- Test project only. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
