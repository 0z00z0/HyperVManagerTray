<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Two sources, and a mapping that decides which one may answer for which package name. The
       clear drops whatever a machine has registered, so a restore resolves the same two feeds
       everywhere.

       The mapping is not optional. Without it restore asks every source for every package, and none
       of the ZeroZero.* names is reserved on nuget.org, so anyone publishing one there could be
       resolved into this application. The mapping, not the absence of a source, is what keeps them
       on the studio feed. It is also all-or-nothing: a package matching no pattern fails to restore
       rather than falling back to another source.

       The studio feed authenticates every read. A token carrying read:packages therefore has to be
       registered wherever a restore happens - against the user-level NuGet.Config on a development
       machine, and as a source added from a secret on a runner. No token belongs in this file; it
       is tracked. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="0z00z0" value="https://nuget.pkg.github.com/0z00z0/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="0z00z0">
      <package pattern="ZeroZero.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
